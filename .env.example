# ─── Google Sheets (obrigatório para o formulário gravar) ───────────────────
# Passo a passo em CLAUDE.md › "Configuração da planilha do Google".
GOOGLE_SERVICE_ACCOUNT_EMAIL="minha-conta@meu-projeto.iam.gserviceaccount.com"
# Cole a private_key do JSON inteira, com os \n literais, entre aspas duplas.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Trecho da URL da planilha entre /d/ e /edit
GOOGLE_SHEET_ID="1AbCdEf..."
# Nome da aba de destino
GOOGLE_SHEET_TAB="Leads"

# ─── Segurança do formulário ────────────────────────────────────────────────
# Assina o timestamp anti-bot. Gere com:  openssl rand -hex 32
FORM_HMAC_SECRET="troque-por-32-bytes-aleatorios-em-hex"

# ─── Site ───────────────────────────────────────────────────────────────────
# URL pública, usada em canonical, sitemap e Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
